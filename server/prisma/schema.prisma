// AndarBahar data model.
//
// Money is always stored as an integer number of MINOR units (paise for INR).
// Never store money as a float - 0.1 + 0.2 problems turn into arguments at the
// table. Format for display only at the edges.
//
// How a night works, and therefore how this is shaped:
//
//   * One player is the banker. Everyone buys chips from them (buyIn) and
//     cashes chips back in at the end (cashOut). Chips are conserved, so
//     total buy-in = total cash-out. That is the check that the numbers were
//     typed in right.
//   * cashOut is the GROSS result - what they won at the table, before any of
//     the night's costs come off.
//   * Costs are then borne by particular players: dinner by whoever won the
//     most, anything else by whoever is chipping in for it.
//   * A player's real result is  (cashOut - buyIn) - their share of the costs.
//
// Nobody is marked as the winner by hand. Winning is what the numbers say.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A person. Every player has their own login; role decides what they can change.
model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  displayName        String
  email              String?  @unique
  phone              String?
  passwordHash       String
  /// "ADMIN" | "PLAYER"
  role               String   @default("PLAYER")
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  /// Bumped on password change / deactivation so old JWTs stop working.
  tokenVersion       Int      @default(0)
  avatarColor        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  gameEntries   GamePlayer[]
  createdGames  Game[]         @relation("GameCreatedBy")
  expenseShares ExpenseShare[]

  @@index([role])
}

/// One game night.
model Game {
  id          String   @id @default(cuid())
  playedOn    DateTime
  title       String?
  location    String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User         @relation("GameCreatedBy", fields: [createdById], references: [id])
  players   GamePlayer[]
  expenses  Expense[]

  @@index([playedOn])
}

/// A player's seat: chips bought, chips cashed back in, and who held the bank.
model GamePlayer {
  id      String @id @default(cuid())
  gameId  String
  userId  String
  /// Chips bought from the banker.
  buyIn   Int    @default(0)
  /// Chips cashed back in - the table result, before any costs come off.
  cashOut Int    @default(0)
  /// At most one per game. Informational: whoever ran the bank that night.
  isBanker Boolean @default(false)
  notes    String?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
}

/// What the night cost.
model Expense {
  id     String  @id @default(cuid())
  gameId String
  /// See ExpenseTypeSchema in src/types/enums.ts.
  type   String  @default("DINNER")
  /// Optional note - "biryani from the usual place". The type carries the meaning.
  label  String?
  amount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  shares ExpenseShare[]

  @@index([gameId])
}

/// Who is carrying a cost. Dinner stores nothing here - it always falls on
/// whoever won the most, which is worked out when the game is read, so that
/// correcting a cash-out moves the bill with it.
model ExpenseShare {
  id        String @id @default(cuid())
  expenseId String
  userId    String

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}
