// AndarBahar data model.
//
// Money is always stored as an integer number of MINOR units (paise for INR).
// Never store money as a float - 0.1 + 0.2 problems turn into arguments at the
// table. Format for display only at the edges.
//
// How a night works, and therefore how this is shaped:
//
//   * One player is the banker. Everyone buys chips from them, and a player
//     can buy in again whenever they run dry - so buy-ins are a list, each
//     with its own time, not a single number.
//   * Cashing out happens ONCE, at the end, and is what they walked away
//     with. Until then the seat has no cash-out and the player is still in.
//   * Chips are conserved, so once everyone has cashed out the buy-ins and
//     the cash-outs have to match.
//   * Several people can buy food over the evening. Each of those is its own
//     row; together they are the night's dinner, and the whole of it falls on
//     whoever won the most.
//   * A player's result is  (cash-out - what they bought in for) - their
//     share of the night's costs.
//
// Nobody is marked as the winner by hand. Winning is what the numbers say.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A person. Every player has their own login; role decides what they can change.
model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  displayName        String
  email              String?  @unique
  phone              String?
  passwordHash       String
  /// "ADMIN" | "PLAYER"
  role               String   @default("PLAYER")
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  /// Bumped on password change / deactivation so old JWTs stop working.
  tokenVersion       Int      @default(0)
  avatarColor        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  gameEntries   GamePlayer[]
  createdGames  Game[]         @relation("GameCreatedBy")
  expensesPaid  Expense[]      @relation("ExpensePaidBy")
  expenseShares ExpenseShare[]

  @@index([role])
}

/// One game night.
model Game {
  id          String   @id @default(cuid())
  playedOn    DateTime
  title       String?
  location    String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User         @relation("GameCreatedBy", fields: [createdById], references: [id])
  players   GamePlayer[]
  expenses  Expense[]

  @@index([playedOn])
}

/// A player's seat for the night.
model GamePlayer {
  id       String   @id @default(cuid())
  gameId   String
  userId   String
  /// When they sat down.
  joinedAt DateTime @default(now())
  /// What they walked away with. Null while they are still playing.
  cashOut     Int?
  cashedOutAt DateTime?
  /// At most one per game. Whoever ran the bank that night.
  isBanker Boolean @default(false)
  notes    String?

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyIns BuyIn[]

  @@unique([gameId, userId])
  @@index([userId])
}

/// One trip to the banker for chips. A player can make several in a night.
model BuyIn {
  id           String   @id @default(cuid())
  gamePlayerId String
  amount       Int
  /// When the chips were bought.
  at           DateTime @default(now())

  gamePlayer GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)

  @@index([gamePlayerId])
}

/// What the night cost. Several dinner rows add up to one dinner bill.
model Expense {
  id     String  @id @default(cuid())
  gameId String
  /// See ExpenseTypeSchema in src/types/enums.ts.
  type   String  @default("DINNER")
  /// Optional note - "starters", "the biryani".
  label  String?
  amount Int
  /// Who actually laid the money out.
  paidById String?
  /// When it was spent.
  at       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  paidBy User?          @relation("ExpensePaidBy", fields: [paidById], references: [id])
  shares ExpenseShare[]

  @@index([gameId])
}

/// Who is carrying a cost. Dinner stores nothing here - the whole bill falls
/// on whoever won the most, worked out when the game is read, so that
/// correcting a cash-out moves it with them.
model ExpenseShare {
  id        String @id @default(cuid())
  expenseId String
  userId    String

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}
