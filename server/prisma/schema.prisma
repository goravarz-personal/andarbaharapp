// AadarBaharApp data model.
//
// Money is always stored as an integer number of MINOR units (paise for INR).
// Never store money as a float - 0.1 + 0.2 problems turn into arguments at the
// table. Format for display only at the edges.
//
// Enum-ish columns are Strings validated with zod at the API boundary (see
// src/types/enums.ts) rather than database enums, so that adding an expense
// type is a code change and not a migration.
//
// The books balance when:   total buy-in  =  total cash-out  +  expenses
//
// Money physically changes hands at the table, so there is nothing to chase
// afterwards: a player's cash-out already includes whatever they won or lost.
// The night's costs come out of the pot, which is why the pot is bigger than
// the sum of what everyone took home.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A person. Every player has their own login; role decides what they can change.
model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  displayName        String
  email              String?  @unique
  phone              String?
  passwordHash       String
  /// "ADMIN" | "PLAYER"
  role               String   @default("PLAYER")
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  /// Bumped on password change / deactivation so old JWTs stop working.
  tokenVersion       Int      @default(0)
  avatarColor        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  gameEntries  GamePlayer[]
  createdGames Game[]       @relation("GameCreatedBy")
  expensesPaid Expense[]    @relation("ExpensePaidBy")

  @@index([role])
}

/// One game night.
model Game {
  id          String   @id @default(cuid())
  playedOn    DateTime
  title       String?
  location    String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User         @relation("GameCreatedBy", fields: [createdById], references: [id])
  players   GamePlayer[]
  expenses  Expense[]

  @@index([playedOn])
}

/// A player's seat in one game: what they put in, what they took out.
model GamePlayer {
  id      String  @id @default(cuid())
  gameId  String
  userId  String
  buyIn   Int     @default(0)
  cashOut Int     @default(0)
  /// At most one per game - the winner is who the night's costs come out of.
  isWinner Boolean @default(false)
  notes    String?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
}

/// What the night cost. Paid out of the pot, so it never splits per player.
model Expense {
  id       String  @id @default(cuid())
  gameId   String
  /// See ExpenseTypeSchema in src/types/enums.ts.
  type     String  @default("DINNER")
  /// Optional note - "biryani and drinks". The type carries the meaning.
  label    String?
  amount   Int
  paidById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  paidBy User @relation("ExpensePaidBy", fields: [paidById], references: [id])

  @@index([gameId])
}
