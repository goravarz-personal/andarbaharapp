# Copy to .env and adjust before running the server.

# SQLite by default - zero setup. Point at Postgres/MySQL by changing the
# provider in prisma/schema.prisma and this URL.
DATABASE_URL="file:./aadarbahar.db"

# CHANGE THIS. Any random string >= 32 chars. Rotating it logs everyone out.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="30d"

PORT=4000
NODE_ENV=development

# Comma separated list, or * to allow any origin (fine for a LAN/home setup).
CORS_ORIGIN="*"

# Bootstrap admin created by `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_DISPLAY_NAME="Game Admin"

# Currency used for formatting. Amounts are stored as integer minor units.
CURRENCY="INR"

# Set to "true" to seed a few demo players and games.
SEED_DEMO_DATA="false"
