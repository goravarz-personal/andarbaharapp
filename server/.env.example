# Copy this file to .env and fill it in.
#
#   cp server/.env.example server/.env
#
# Every one of these can also be set in your host's dashboard instead of a
# file, which is how a deployed server gets them.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. A free database from neon.com looks like:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/aadarbahar?sslmode=require
# Running Postgres locally instead? `docker compose up -d` then use:
#   postgresql://aadar:aadar@localhost:5432/aadarbahar
DATABASE_URL=

# Signs everyone's sign-in tokens. Must be at least 32 characters in
# production, and changing it signs everybody out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- The first admin account ------------------------------------------------
# Created automatically the first time the server starts against an empty
# database. Changing these later does nothing - manage accounts in the app.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Game Admin

# --- Optional ---------------------------------------------------------------

# The address the app is served from, so the browser is allowed to call this
# API. Comma-separate several. "*" allows any origin.
CORS_ORIGIN=*

PORT=4000
NODE_ENV=development

# How long a sign-in lasts before the app asks for a password again.
JWT_EXPIRES_IN=30d

# Formatting only. Amounts are always stored as integer minor units.
CURRENCY=INR

# Number of proxies between the internet and this server. Hosts like Render put
# exactly one in front. Getting this wrong makes rate limiting useless.
TRUST_PROXY=1

# Set to true and run `npm run db:seed` to add demo players and games.
SEED_DEMO_DATA=false
